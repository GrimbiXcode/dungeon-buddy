# ---------------------------------------------------------------------------
# Dungeon Buddy – Konfiguration (kopieren nach .env und ausfüllen)
# ---------------------------------------------------------------------------

# Zufälliges Secret zum Signieren der Sitzungen (mind. 32 Zeichen):
#   openssl rand -hex 32
APP_SECRET=bitte-zufaelligen-wert-eintragen

# PostgreSQL-Verbindung (wird in docker-compose.yml überschrieben)
DATABASE_URL=postgres://dungeonbuddy:change-me@localhost:5432/dungeonbuddy

# Telegram-Bot (bei @BotFather anlegen, siehe README)
TELEGRAM_BOT_TOKEN=123456789:ABCdeFGhiJKlmnoPQRstuVWxyz
TELEGRAM_BOT_USERNAME=DeinDungeonBuddyBot

# Wer darf sich anmelden? Kommagetrennte Telegram-User-IDs.
# Deine eigene ID nennt dir der Bot, wenn du ihm /id schreibst.
# Ist die Liste leer, kann sich niemand anmelden – ausser die Registrierung
# wird unten ausdrücklich geöffnet.
TELEGRAM_ALLOWED_IDS=123456789

# Anmeldung für jeden Telegram-Nutzer öffnen. Wirkt nur, wenn
# TELEGRAM_ALLOWED_IDS leer ist – sonst gilt die Freigabeliste.
# Damit bist du für die Daten aller Nutzer verantwortlich.
# TELEGRAM_OPEN_REGISTRATION=1

# Telegram-ID des Betreibers. Dieses Konto wird bei jeder Anmeldung Admin.
# Ohne diese Variable wird mit Freigabeliste der erste Benutzer Admin, bei
# offener Registrierung niemand.
# OWNER_TELEGRAM_ID=123456789

# Öffentliche Adresse der Instanz, für Links in Bot-Nachrichten (Alarm an Admins)
# APP_BASE_URL=https://dnd.example.org

# Name der Instanz (erscheint in Bot-Nachrichten)
# APP_NAME=Dungeon Buddy

# Port (Standard 3000)
# PORT=3000

# Adresse, auf der der Server lauscht. Standard: "::" (IPv4 und IPv6),
# ohne IPv6 auf dem Host automatisch 0.0.0.0.
# HOST=::

# Cookie nur über HTTPS senden. Standard: an in Produktion. Nur für reine
# HTTP-Tests im LAN auf 0 setzen.
# SECURE_COOKIES=1

# Hinter einem Reverse Proxy die Client-IP aus X-Forwarded-For lesen
# (für das Rate-Limit der Anmeldung; wird nicht gespeichert). Standard: 1.
# TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Anhänge (Bilder, PDFs) in einem S3-kompatiblen Object Storage.
# Ohne S3_BUCKET sind Anhänge aus. Bucket privat lassen (kein Public Access);
# die App liefert die Dateien selbst aus, CORS ist nicht nötig.
# ---------------------------------------------------------------------------

# Hetzner Object Storage (Standort wie der Server, z. B. fsn1, nbg1, hel1):
# S3_ENDPOINT=https://fsn1.your-objectstorage.com
# S3_REGION=fsn1
# S3_BUCKET=dungeon-buddy-prod
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...

# Lokale Entwicklung mit SeaweedFS (docker compose up -d s3):
# S3_ENDPOINT=http://localhost:8333
# S3_BUCKET=dungeon-buddy
# S3_ACCESS_KEY_ID=dungeonbuddy
# S3_SECRET_ACCESS_KEY=change-me-too
# S3_FORCE_PATH_STYLE=1
# S3_CREATE_BUCKET=1

# Nur lokale Entwicklung: Anmeldung ohne Telegram über einen Button.
# Wirkt nie mit NODE_ENV=production.
# DEV_LOGIN=1
