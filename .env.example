# ---------------------------------------------------------------------------
# Dungeon Buddy – Konfiguration (kopieren nach .env und ausfüllen)
# ---------------------------------------------------------------------------

# Zufälliges Secret zum Signieren der Sitzungen (mind. 32 Zeichen):
#   openssl rand -hex 32
APP_SECRET=bitte-zufaelligen-wert-eintragen

# PostgreSQL-Verbindung (wird in docker-compose.yml überschrieben)
DATABASE_URL=postgres://dungeonbuddy:change-me@localhost:5432/dungeonbuddy

# Telegram-Bot (bei @BotFather anlegen, siehe README)
TELEGRAM_BOT_TOKEN=123456789:ABCdeFGhiJKlmnoPQRstuVWxyz
TELEGRAM_BOT_USERNAME=DeinDungeonBuddyBot

# Wer darf sich anmelden? Kommagetrennte Telegram-User-IDs.
# Deine eigene ID nennt dir der Bot, wenn du ihm /id schreibst.
# Ist die Liste leer, kann sich niemand anmelden – ausser die Registrierung
# wird unten ausdrücklich geöffnet.
TELEGRAM_ALLOWED_IDS=123456789

# Anmeldung für jeden Telegram-Nutzer öffnen (nur mit leerer Liste oben).
# Damit bist du für die Daten aller Nutzer verantwortlich.
# TELEGRAM_OPEN_REGISTRATION=1

# Name der Instanz (erscheint in Bot-Nachrichten)
# APP_NAME=Dungeon Buddy

# Port (Standard 3000)
# PORT=3000

# Cookie nur über HTTPS senden. Standard: an in Produktion. Nur für reine
# HTTP-Tests im LAN auf 0 setzen.
# SECURE_COOKIES=1

# Hinter einem Reverse Proxy die Client-IP aus X-Forwarded-For lesen
# (für das Rate-Limit der Anmeldung; wird nicht gespeichert). Standard: 1.
# TRUST_PROXY=1

# Nur lokale Entwicklung: Anmeldung ohne Telegram über einen Button.
# Wirkt nie mit NODE_ENV=production.
# DEV_LOGIN=1
